@using HTNL.Edu.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Course>
@{
    ViewData["Title"] = "Quản lý khóa học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<style>
    .alert {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }
</style>

<div class="table-card">
    <div class="table-header">
        <h2><i class="fas fa-book"></i> Danh sách khóa học</h2>
        <div class="table-actions">
            <form method="get" style="display: flex; gap: 1rem;">
                <select name="categoryId" class="form-control" style="width: 200px;" onchange="this.form.submit()">
                    <option value="0">Tất cả danh mục</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.CategoryID"
                                selected="@(ViewBag.CurrentCategory == category.CategoryID)">
                            @category.CategoryName
                        </option>

                    }
                </select>
                <div class="search-box">
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           placeholder="Tìm kiếm khóa học..." class="form-control">
                    <i class="fas fa-search"></i>
                </div>
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm khóa học
            </a>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên khóa học</th>
                <th>Danh mục</th>
                <th>Mô tả</th>
                <th style="text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var course in Model)
                {
                    <tr>
                        <td><strong>#@course.CourseID</strong></td>
                        <td>
                            <img src="@course.CourseImage" alt="@course.CourseName"
                                 class="course-img-thumb"
                                 onerror="this.src='/img/course_img/default.jpg'">
                        </td>
                        <td>
                            <strong>@course.CourseName</strong>
                        </td>
                        <td>
                            <span class="badge badge-primary">
                                @course.Category?.CategoryName
                            </span>
                        </td>
                        <td>
                            @(course.Description?.Length > 80
                                                ? course.Description.Substring(0, 80) + "..."
                                                : course.Description)
                </td>
                <td style="text-align: center;">
                    <a asp-action="Details" asp-route-id="@course.CourseID"
                       class="btn btn-primary btn-sm" title="Xem chi tiết">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@course.CourseID"
                       class="btn btn-warning btn-sm" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@course.CourseID"
                       class="btn btn-danger btn-sm" title="Xóa">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
                        }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem; color: #6b7280;">
                        <i class="fas fa-inbox" style="font-size: 3rem; margin-bottom: 1rem; display: block;"></i>
                        Không tìm thấy khóa học nào
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Any())
    {
        <div style="padding: 1.5rem; text-align: center; border-top: 1px solid #e5e7eb; color: #6b7280;">
            Tổng cộng: <strong>@Model.Count()</strong> khóa học
        </div>
    }
</div>