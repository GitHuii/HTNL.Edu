@using HTNL.Edu.Models
@model User
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Xóa người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .delete-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        max-width: 600px;
        margin: 0 auto;
    }

    .delete-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fef2f2;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

        .delete-header h2 {
            font-size: 1.3rem;
            color: #dc2626;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .delete-body {
        padding: 2rem;
    }

    .warning-box {
        background: #fef2f2;
        border: 2px solid #fecaca;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: start;
        gap: 1rem;
    }

        .warning-box i {
            color: #dc2626;
            font-size: 2rem;
            flex-shrink: 0;
        }

    .warning-content h3 {
        color: #991b1b;
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
    }

    .warning-content p {
        color: #7f1d1d;
        margin: 0;
        line-height: 1.6;
    }

    .user-info-box {
        background: #f9fafb;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .info-row {
        display: flex;
        padding: 0.8rem 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        font-weight: 600;
        color: #6b7280;
        min-width: 140px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-value {
        color: #1f2937;
        flex: 1;
    }

    .confirmation-box {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .confirmation-box i {
            color: #ea580c;
        }

        .confirmation-box p {
            margin: 0;
            color: #7c2d12;
            font-size: 0.95rem;
        }

    .form-actions {
        display: flex;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .btn-delete-confirm {
        background: #dc2626;
        color: white;
    }

        .btn-delete-confirm:hover {
            background: #b91c1c;
        }
</style>

<div class="delete-card">
    <div class="delete-header">
        <h2>
            <i class="fas fa-exclamation-triangle"></i> Xác nhận xóa người dùng
        </h2>
        <a asp-action="Index" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="delete-body">
        <div class="warning-box">
            <i class="fas fa-exclamation-circle"></i>
            <div class="warning-content">
                <h3>Cảnh báo: Thao tác này không thể hoàn tác!</h3>
                <p>
                    Bạn đang chuẩn bị xóa người dùng khỏi hệ thống.
                    Tất cả dữ liệu liên quan đến người dùng này sẽ bị xóa vĩnh viễn.
                    Vui lòng kiểm tra kỹ thông tin trước khi thực hiện.
                </p>
            </div>
        </div>

        <h3 style="margin-bottom: 1rem; color: #1f2937;">
            <i class="fas fa-info-circle"></i> Thông tin người dùng
        </h3>

        <div class="user-info-box">
            <div class="info-row">
                <span class="info-label">
                    <i class="fas fa-hashtag"></i> ID:
                </span>
                <span class="info-value"><strong>#@Model.UserID</strong></span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="fas fa-user"></i> Tên đăng nhập:
                </span>
                <span class="info-value"><strong>@Model.UserName</strong></span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="fas fa-id-card"></i> Họ và tên:
                </span>
                <span class="info-value">@Model.FullName</span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="fas fa-envelope"></i> Email:
                </span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="fas fa-user-shield"></i> Vai trò:
                </span>
                <span class="info-value">
                    @if (Model.Role == "Admin")
                    {
                        <span class="badge badge-warning">
                            <i class="fas fa-crown"></i> Quản trị viên
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-primary">
                            <i class="fas fa-user"></i> Người dùng
                        </span>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">
                    <i class="fas fa-calendar"></i> Streak:
                </span>
                <span class="info-value">@Model.Streak</span>
            </div>
        </div>

        <div class="confirmation-box">
            <i class="fas fa-question-circle"></i>
            <p>
                <strong>Bạn có chắc chắn muốn xóa người dùng "@Model.FullName" (@Model.UserName)?</strong>
            </p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="UserID" />

            <div class="form-actions">
                <button type="submit" class="btn btn-delete-confirm">
                    <i class="fas fa-trash"></i> Xác nhận xóa
                </button>
                <a asp-action="Index" class="btn btn-success">
                    <i class="fas fa-times"></i> Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            if (!confirm('Bạn có CHẮC CHẮN muốn xóa người dùng này?\n\nThao tác này KHÔNG THỂ hoàn tác!')) {
                e.preventDefault();
                return false;
            }
        });
    </script>
}