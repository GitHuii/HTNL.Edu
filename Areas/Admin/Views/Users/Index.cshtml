@using HTNL.Edu.Models
@model IEnumerable<User>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<style>
    .alert {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }
</style>

<div class="table-card">
    <div class="table-header">
        <h2><i class="fas fa-users"></i> Danh sách người dùng</h2>
        <div class="table-actions">
            <form method="get" style="display: flex; gap: 1rem;">
                <select name="roleFilter" class="form-control" style="width: 150px;" onchange="this.form.submit()">
                    <option value="All"
                            selected="@(ViewBag.RoleFilter == "All" || string.IsNullOrEmpty(ViewBag.RoleFilter))">
                        Tất cả vai trò
                    </option>

                    <option value="Admin"
                            selected="@(ViewBag.RoleFilter == "Admin")">
                        Admin
                    </option>

                    <option value="User"
                            selected="@(ViewBag.RoleFilter == "User")">
                        User
                    </option>
                </select>
                <div class="search-box">
                    <input type="text" name="searchString" value="@ViewBag.SearchString"
                           placeholder="Tìm kiếm người dùng..." class="form-control">
                    <i class="fas fa-search"></i>
                </div>
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Thêm người dùng
            </a>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Streak</th>
                <th style="text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td><strong>#@user.UserID</strong></td>
                        <td>
                            <i class="fas fa-user"></i> @user.UserName
                        </td>
                        <td>@user.FullName</td>
                        <td>
                            <i class="fas fa-envelope"></i> @user.Email
                        </td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-crown"></i> Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-primary">
                                    <i class="fas fa-user"></i> User
                                </span>
                            }
                        </td>
                        <td>
                            <i class="fa-solid fa-fire"></i> @user.Streak
                        </td>
                        <td style="text-align: center;">
                            <a asp-action="Details" asp-route-id="@user.UserID"
                               class="btn btn-primary btn-sm" title="Xem chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@user.UserID"
                               class="btn btn-warning btn-sm" title="Chỉnh sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@user.UserID"
                               class="btn btn-danger btn-sm" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; padding: 2rem; color: #6b7280;">
                        <i class="fas fa-user-slash" style="font-size: 3rem; margin-bottom: 1rem; display: block;"></i>
                        Không tìm thấy người dùng nào
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Any())
    {
        <div style="padding: 1.5rem; text-align: center; border-top: 1px solid #e5e7eb; color: #6b7280;">
            Tổng cộng: <strong>@Model.Count()</strong> người dùng
        </div>
    }
</div>