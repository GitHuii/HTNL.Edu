@model CourseDetail

@{
    ViewData["Title"] = Model.Course?.CourseName;

    var totalLessons = Model.Course?.Lessons?.Count ?? 0;
    var completedLessons = Model.CourseDetailLessons?.Count(cdl => cdl.IsDone) ?? 0;
    var progressPercent = totalLessons > 0 ? (int)((completedLessons * 100.0) / totalLessons) : 0;
    var totalDuration = Model.Course?.Lessons?.Sum(l => l.Duration) ?? 0;
}

<style>
    .course-info-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
    }

    .breadcrumb {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        opacity: 0.9;
    }

        .breadcrumb a {
            color: white;
            text-decoration: none;
        }

            .breadcrumb a:hover {
                text-decoration: underline;
            }

    .course-header-content {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 2rem;
        align-items: start;
    }

    .course-thumbnail {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    }

    .course-header-info h1 {
        font-size: 2rem;
        margin: 0 0 1rem 0;
        font-weight: 700;
    }

    .course-category {
        display: inline-block;
        background: rgba(255, 255, 255, 0.2);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .course-description {
        font-size: 1.1rem;
        line-height: 1.6;
        opacity: 0.95;
        margin-bottom: 1.5rem;
    }

    .progress-section {
        background: rgba(255, 255, 255, 0.15);
        padding: 1.5rem;
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .progress-label {
        font-weight: 600;
        font-size: 1rem;
    }

    .progress-percent {
        font-weight: 700;
        font-size: 1.5rem;
    }

    .progress-bar-container {
        height: 12px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
        transition: width 0.5s;
        border-radius: 10px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 1rem;
    }

    .stat-item {
        text-align: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 8px;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .back-button {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        transition: all 0.2s;
    }

        .back-button:hover {
            background: rgba(255, 255, 255, 0.3);
        }

    .lessons-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem 3rem;
    }

    .lessons-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .section-header {
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #e5e7eb;
        background: #f9fafb;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }

    .lessons-list {
        padding: 0;
        margin: 0;
    }

    .lesson-item {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #e5e7eb;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        color: inherit;
    }

        .lesson-item:hover {
            background: #f9fafb;
        }

        .lesson-item:last-child {
            border-bottom: none;
        }

        .lesson-item.active {
            background: #eff6ff;
            border-left: 4px solid #3b82f6;
        }

    .lesson-check {
        width: 28px;
        height: 28px;
        border: 2px solid #d1d5db;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.875rem;
    }

    .lesson-item.completed .lesson-check {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }

    .lesson-number {
        width: 40px;
        height: 40px;
        background: #3b82f6;
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .lesson-item.completed .lesson-number {
        background: #10b981;
    }

    .lesson-content {
        flex: 1;
        min-width: 0;
    }

    .lesson-name {
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
        font-size: 1.05rem;
        line-height: 1.4;
    }

    .lesson-item.active .lesson-name {
        color: #3b82f6;
    }

    .lesson-meta {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .lesson-duration {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

        .lesson-duration i {
            color: #3b82f6;
        }

    .lesson-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.75rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

        .lesson-status.completed {
            background: #d1fae5;
            color: #065f46;
        }

        .lesson-status.not-completed {
            background: #f3f4f6;
            color: #6b7280;
        }

    .lesson-play-icon {
        width: 40px;
        height: 40px;
        background: #3b82f6;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
        transition: all 0.2s;
    }

    .lesson-item:hover .lesson-play-icon {
        background: #2563eb;
        transform: scale(1.1);
    }

    .lesson-item.completed .lesson-play-icon {
        background: #10b981;
    }

    .lesson-item.completed:hover .lesson-play-icon {
        background: #059669;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }

        .empty-state i {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 1rem;
        }

        .empty-state p {
            font-size: 1.25rem;
            color: #6b7280;
        }

    .lessons-footer {
        padding: 1rem 2rem;
        text-align: center;
        border-top: 1px solid #e5e7eb;
        background: #f9fafb;
        color: #6b7280;
        font-size: 0.9rem;
    }
</style>

<!-- Header -->
<div class="course-info-header">
    <div class="container">
        <div class="breadcrumb">
            <a asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Trang chủ
            </a>
            <span>/</span>
            <a asp-controller="Course" asp-action="MyCourses">Khóa học của tôi</a>
            <span>/</span>
            <span>@Model.Course?.CourseName</span>
        </div>

        <div class="course-header-content">
            <div>
                <img src="@Model.Course?.CourseImage" alt="@Model.Course?.CourseName"
                     class="course-thumbnail"
                     onerror="this.src='https://via.placeholder.com/300x200/667eea/ffffff?text=Course'">
            </div>

            <div class="course-header-info">
                <span class="course-category">
                    <i class="fas fa-tag"></i> @Model.Course?.Category?.CategoryName
                </span>
                <h1>@Model.Course?.CourseName</h1>
                <p class="course-description">@Model.Course?.Description</p>

                <div class="progress-section">
                    <div class="progress-header">
                        <span class="progress-label">Tiến độ học tập</span>
                        <span class="progress-percent">@progressPercent%</span>
                    </div>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: @progressPercent%"></div>
                    </div>

                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-value">@completedLessons/@totalLessons</div>
                            <div class="stat-label">Bài hoàn thành</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@totalDuration</div>
                            <div class="stat-label">Phút học</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.LastTime.ToString("dd/MM")</div>
                            <div class="stat-label">Lần cuối</div>
                        </div>
                    </div>
                </div>

                <a asp-controller="Course" asp-action="MyCourses" class="back-button">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Lessons List -->
<div class="lessons-container">
    <div class="lessons-card">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-list-ul"></i>
                Danh sách bài học (@totalLessons bài)
            </h2>
        </div>

        @if (Model.Course?.Lessons != null && Model.Course.Lessons.Any())
        {
            <div class="lessons-list">
                @{
                    var lessonNumber = 1;
                }
                @foreach (var lesson in Model.Course.Lessons.OrderBy(l => l.LessonID))
                {
                    var progress = Model.CourseDetailLessons?.FirstOrDefault(cdl => cdl.LessonID == lesson.LessonID);
                    var isCompleted = progress?.IsDone ?? false;

                    <a asp-controller="Learn"
                       asp-action="Index"
                       asp-route-courseId="@Model.CourseID"
                       asp-route-lessonId="@lesson.LessonID"
                       class="lesson-item @(isCompleted ? "completed" : "")">

                        <div class="lesson-check">
                            @if (isCompleted)
                            {
                                <i class="fas fa-check"></i>
                            }
                        </div>

                        <div class="lesson-number">@lessonNumber</div>

                        <div class="lesson-content">
                            <div class="lesson-name">@lesson.LessonName</div>
                            <div class="lesson-meta">
                                <div class="lesson-duration">
                                    <i class="fas fa-clock"></i>
                                    <span>@lesson.Duration phút</span>
                                </div>
                                @if (isCompleted)
                                {
                                    <div class="lesson-status completed">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Đã hoàn thành</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="lesson-status not-completed">
                                        <i class="far fa-circle"></i>
                                        <span>Chưa học</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="lesson-play-icon">
                            <i class="fas fa-play"></i>
                        </div>
                    </a>

                    lessonNumber++;
                }
            </div>

            <div class="lessons-footer">
                <strong>@completedLessons/@totalLessons</strong> bài học đã hoàn thành •
                <strong>@progressPercent%</strong> tiến độ
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>Khóa học chưa có bài học nào</p>
            </div>
        }
    </div>
</div>