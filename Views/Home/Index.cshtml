            </div>

            <div class="testimonial-card">
                <div class="stars">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                </div>
                <p class="testimonial-text">"Học hoàn toàn miễn phí mà chất lượng không thua gì các khóa học trả phí. Video bài giảng rõ ràng, dễ hiểu. 5 sao không có gì để chê!"</p>
                <div class="testimonial-author">
                    <div class="author-avatar">H</div>
                    <div class="author-info">
                        <h4>Lê Quang Huy</h4>
                        <p>Freelancer</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Sẵn sàng bắt đầu hành trình của bạn?</h2>
            <p>Tham gia cùng hàng nghìn học viên đang học tập và phát triển mỗi ngày</p>
            <div class="cta-buttons">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Course" asp-action="Index" class="btn-hero btn-hero-primary">
                        <i class="fas fa-book-open"></i>
                        Khám phá khóa học
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn-hero btn-hero-primary">
                        <i class="fas fa-user-plus"></i>
                        Đăng ký miễn phí
                    </a>
                    <a asp-controller="Course" asp-action="Index" class="btn-hero btn-hero-outline">
                        <i class="fas fa-search"></i>
                        Xem khóa học
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentSkip = 3; // Đã load 3 courses ban đầu
        const totalCourses = @totalCourses;
        const btnLoadMore = document.getElementById('btnLoadMore');
        const loadingSpinner = document.getElementById('loadingSpinner');
        const coursesGrid = document.getElementById('coursesGrid');
        const coursesCount = document.getElementById('coursesCount');
        const loadMoreContainer = document.getElementById('loadMoreContainer');

        if (btnLoadMore) {
            btnLoadMore.addEventListener('click', async function() {
                // Show loading
                btnLoadMore.style.display = 'none';
                loadingSpinner.style.display = 'flex';

                try {
                    const response = await fetch(`/Home/LoadMoreCourses?skip=${currentSkip}&take=3`);
                    const data = await response.json();

                    if (data.courses && data.courses.length > 0) {
                        // Add new courses
                        data.courses.forEach(course => {
                            const courseCard = createCourseCard(course);
                            coursesGrid.appendChild(courseCard);
                        });

                        // Update counter
                        currentSkip += data.courses.length;
                        coursesCount.textContent = currentSkip;

                        // Check if there are more courses
                        if (!data.hasMore || currentSkip >= totalCourses) {
                            loadMoreContainer.style.display = 'none';
                        }
                    }

                    // Hide loading
                    loadingSpinner.style.display = 'none';
                    btnLoadMore.style.display = 'inline-flex';

                } catch (error) {
                    console.error('Error loading courses:', error);
                    loadingSpinner.style.display = 'none';
                    btnLoadMore.style.display = 'inline-flex';
                    alert('Có lỗi xảy ra khi tải khóa học. Vui lòng thử lại!');
                }
            });
        }

        function createCourseCard(course) {
            const card = document.createElement('div');
            card.className = 'course-card new';

            const imageUrl = course.imageUrl || `https://via.placeholder.com/400x250/667eea/ffffff?text=${encodeURIComponent(course.courseName || 'Course')}`;

            card.innerHTML = `
                <img src="${imageUrl}"
                     alt="${course.courseName}"
                     class="course-image"
                     onerror="this.src='https://via.placeholder.com/400x250/667eea/ffffff?text=Course'">
                <div class="course-content">
                    <span class="course-category">
                        <i class="fas fa-tag"></i> ${course.categoryName}
                    </span>
                    <h3 class="course-title">${course.courseName}</h3>
                    <p class="course-description">${course.description || ''}</p>
                    <div class="course-meta">
                        <div class="course-lessons">
                            <i class="fas fa-play-circle"></i>
                            <span>${course.lessonCount} bài học</span>
                        </div>
                        <a href="/Course/Details/${course.courseID}" class="btn-enroll">
                            Xem khóa học
                        </a>
                    </div>
                </div>
            `;

            return card;
        }
    });
</script>